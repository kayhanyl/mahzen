{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Retina mode is sharper but heavier; keep it off in slow games." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Retina modu keskin ama daha ağırdır; yavaş oyunlarda kapalı tut."
          }
        }
      }
    },
    "%@ failed (exit code %d). See the logs for details." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ failed (exit code %2$d). See the logs for details."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ başarısız oldu (çıkış kodu %2$d). Ayrıntılar loglarda."
          }
        }
      }
    },
    "%@ · %@" : {
      "shouldTranslate" : false
    },
    "A bottle is a virtual C: drive that Windows programs are installed into. Create your first bottle." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bottle, Windows programlarının kurulduğu sanal bir C: sürücüsüdür. İlk bottle’ını oluştur."
          }
        }
      }
    },
    "A program is running" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışan program var"
          }
        }
      }
    },
    "All programs, games and saves in it are deleted permanently." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçindeki tüm programlar, oyunlar ve kayıtlar kalıcı olarak silinir."
          }
        }
      }
    },
    "Applying settings…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar uygulanıyor…"
