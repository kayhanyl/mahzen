    "Delete “%@”?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” silinsin mi?"
          }
        }
      }
    },
    "DirectX 10/11 → Metal (open source). Recommended for DirectX 11 games." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 10/11 → Metal (açık kaynak). DirectX 11 oyunlar için önerilen."
          }
        }
      }
    },
    "DirectX 11/12 → Metal (Apple). For DirectX 12 games; some DX11 games crash on it (e.g. Kenshi)." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 11/12 → Metal (Apple). DirectX 12 oyunlar için; bazı DX11 oyunlarda çöküyor (ör. Kenshi)."
          }
        }
      }
    },
    "DirectX → OpenGL. Slow but the most compatible; for older games." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX → OpenGL. Yavaş ama en uyumlu; eski oyunlar için."
          }
        }
      }
    },
